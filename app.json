{
  "expo": {
    "name": "Mera Coach",
    "slug": "meracoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/platform/icon.png",
    "scheme": "meracoach",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meracoach.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.meracoach.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1b4332",
        "foregroundImage": "./assets/platform/android-icon-foreground.png",
        "backgroundImage": "./assets/platform/android-icon-background.png",
        "monochromeImage": "./assets/platform/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/platform/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mera Coach to access your photos to upload a profile picture or logo.",
          "cameraPermission": "Allow Mera Coach to use the camera to take a profile picture or progress photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/platform/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1b4332"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "expo-system-ui"
    ]
  }
}
