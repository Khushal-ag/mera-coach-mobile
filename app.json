{
  "expo": {
    "name": "Mera Coach",
    "slug": "meracoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/platform/icon.png",
    "scheme": "meracoach",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.henchsolutions.meracoach",
      "buildNumber": "1",
      "icon": "./assets/platform/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Mera Coach",
        "LSApplicationQueriesSchemes": ["mailto", "sms", "tel", "mailto", "sms", "tel"]
      }
    },
    "android": {
      "package": "com.henchsolutions.meracoach",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1b4332",
        "foregroundImage": "./assets/platform/android-icon-foreground.png",
        "backgroundImage": "./assets/platform/android-icon-background.png",
        "monochromeImage": "./assets/platform/android-icon-monochrome.png"
      },
      "icon": "./assets/platform/icon.png"
    },
    "web": {
      "favicon": "./assets/platform/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mera Coach to access your photos to upload a profile picture or logo.",
          "cameraPermission": "Allow Mera Coach to use the camera to take a profile picture or progress photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/platform/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#03422f"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "expo-system-ui"
    ],
    "extra": {
      "eas": {
        "projectId": "4ea7fb73-5e9f-42bf-9dea-e39a9278cc00"
      }
    },
    "owner": "khushal-ag",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4ea7fb73-5e9f-42bf-9dea-e39a9278cc00"
    }
