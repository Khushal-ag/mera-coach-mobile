# Copy to `.env` for local development.
# For EAS / store builds, set the same keys as EAS secrets.

# API base URL (required)
EXPO_PUBLIC_API_BASE_URL=https://careaitestmcapi-ecg7dyhbbfftdbds.centralindia-01.azurewebsites.net

# Optional — Play Console privacy policy link
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Public website used for client feedback SMS links (`/feedback?coachCode=&clientCode=`)
EXPO_PUBLIC_WEB_BASE_URL=https://mera-coach.com

# Demo data for packages / events / gallery when the API returns empty.
# Defaults to true when unset. Set false for empty sections without demo seed.
EXPO_PUBLIC_USE_MVP_MOCKS=true
