# Copy to `.env` for local development.
# For EAS / store builds, set the same keys as EAS Secrets / env for the production profile.
# Never commit real `.env` values.

# required — production API host (all REST endpoints + /document image URLs)
# Example (Azure): https://meracoachapi.azurewebsites.net
# Example (local): http://localhost:5xxx  — do NOT use localhost for store builds
EXPO_PUBLIC_API_BASE_URL=

# optional — public marketing site (feedback SMS links default to https://mera-coach.com)
EXPO_PUBLIC_WEB_BASE_URL=

# optional — hosted privacy policy URL required by Play Console / App Store listing
# If unset, the in-app Legal screen still shows the policy text.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
