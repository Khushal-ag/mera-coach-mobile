# Copy to `.env` for local development.
# For EAS / store builds, set the same keys as EAS secrets.

# required — API used for all endpoints and /document image URLs
EXPO_PUBLIC_API_BASE_URL=

# optional — public site for client feedback SMS links
EXPO_PUBLIC_WEB_BASE_URL=

# optional — Play Console privacy policy link
EXPO_PUBLIC_PRIVACY_POLICY_URL=
